# Sales-Visit-Log environment configuration
# Copy to .env (local dev) or set in Railway dashboard (production)

# ── Database ───────────────────────────────────────────────────────────────
# Railway: use the managed Postgres connection string
DATABASE_URL=postgres://svl:svl@localhost:5432/sales_visit_log

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080

# ── Object Storage (Cloudflare R2) ─────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=sales-visit-log

# ── Transcription (OpenAI) ─────────────────────────────────────────────────
# Required for voice note transcription. Without this, uploads work but
# transcription is skipped.
OPENAI_API_KEY=sk-...

# ── Agent API ──────────────────────────────────────────────────────────────
# Shared secret for Hermes agent authentication. Generate a strong random key.
AGENT_API_KEY=change-me

# ── Callback Cron ──────────────────────────────────────────────────────────
CALLBACK_CRON_ENABLED=true
CALLBACK_CRON_HOUR=7
CALLBACK_CRON_TZ_OFFSET_MIN=0

# ── Hermes Agent (for scheduled behaviors) ─────────────────────────────────
# Base URL of the running API server
HERMES_BASE_URL=http://localhost:8080
# Comma-separated rep IDs (until team auth / rep registry exists)
HERMES_REP_IDS=rep-1

# ── Frontend ───────────────────────────────────────────────────────────────
# Cloudflare Pages: set this to your Pages domain
# API URL the frontend calls (set to Railway domain in production)
VITE_API_URL=http://localhost:8080
# Clerk publishable key (from Clerk dashboard)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_***

# ── Clerk (backend) ────────────────────────────────────────────────────────
# Secret key for resolving user display names from the API
CLERK_SECRET_KEY=sk_test_***
# Your Clerk frontend API hostname (e.g. your-app.clerk.accounts.dev)
CLERK_HOSTNAME=your-app.clerk.accounts.dev
